{
  "name": "paragon-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Backend Paragon Supply Collaboration Hub — Node + SQLite",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/index.js --migrate-only",
    "seed": "node src/db/seed.js",
    "reset": "rm -rf data storage && npm run seed",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
